PROMOFORGE_ENV=development
PROMOFORGE_HOST=127.0.0.1
PROMOFORGE_PORT=8000
PROMOFORGE_ALLOWED_ORIGINS=http://127.0.0.1:8443,http://localhost:8443,http://127.0.0.1:4173,http://localhost:4173
DATABASE_URL=sqlite:///../data/promoforge.db

# Added when M3 begins. Never place a real key in source control.
LLM_PROVIDER=fallback
LLM_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=
MAX_CONCURRENT_REQUESTS=2
MAX_RETRIES=3
PROVIDER_TIMEOUT_SECONDS=60

MIN_PROMO_SECONDS=20
MAX_PROMO_SECONDS=60
MAX_SEGMENTS=3
DEDUP_THRESHOLD=0.65
CAMPAIGN_DIVERSITY_LAMBDA=0.65

